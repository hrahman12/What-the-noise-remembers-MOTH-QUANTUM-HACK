# secrets: the Atlas API key lives only in .env (see .env.example)
.env
.env.*
!.env.example

# tooling
__pycache__/
*.pyc
node_modules/
.pytest_cache/
*.egg-info/
build/
dist/

# regenerable or downloadable data (each piece's scripts fetch or rebuild these)
cache/files/
cache/pending/
cache/archive*/
cache/publish/
cache/*.bak
entries/*/inputs/
entries/*/scratch/
entries/*/out/frames/
entries/*/data/raw/
*.h5ad
*.hdf5
*.tar.gz

# local QA output and working history
entries/*/qa/*.png
entries/*/qa/report.json
entries/*/qa/deadcontrols.json
entries/*/history/
site/web/
site/qa/
site_check_report.json

# third-party screenshots and reference copies (not ours to redistribute)
Moth hack*.png
reference/

# demo recording scratch
common/demo_work/

# large raw masters: the pages use the mp3/webp/mp4 copies under each piece's web/ folder
entries/**/*.wav
!entries/*/web/**/*.wav
*.fits
entries/03-moth-eye/moth_eye.mp4
entries/04-magic-angle/magic_angle.mp4

# full Atlas job outputs (~100 MB) stay local; cache/ledger.jsonl and cache/jobs_index.json record every job
cache/*/
cache/*.bak
cache/assets.json

# form uploads assembled per challenge (copies of files already in the repo)
submission/
